NODE_ENV=development
PORT=4000

# Supabase project (server-side only — the secret key must never be
# sent to, or embedded in, the frontend).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_STORAGE_BUCKET=creatiq-assets

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGIN=http://localhost:3000

# Image generation provider: "stub" (default, no cost, deterministic
# placeholder) or "cloudflare" (real images via Cloudflare Workers AI).
# See src/services/ai/README.md before setting this to "cloudflare" —
# it is free up to a documented daily quota on the Workers FREE plan,
# but requires you to confirm your Cloudflare account has not been
# upgraded to a paid plan.
AI_PROVIDER=stub

# Required only when AI_PROVIDER=cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Instagram publishing via Meta's Graph API. Optional — without all
# three set, /api/instagram/* endpoints fail cleanly with a clear
# "not configured" error instead of attempting any Meta API call.
# Requires a Meta Developer app with the Instagram Graph API product,
# a Facebook Page linked to an Instagram Business/Creator account,
# and — for any user beyond the app's own registered testers — Meta
# App Review approval for instagram_basic, instagram_content_publish,
# and pages_read_engagement. See src/services/instagram/README.md
# before setting these.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/instagram/callback
