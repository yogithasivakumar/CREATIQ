NODE_ENV=development
PORT=4000

# Supabase project (server-side only — the secret key must never be
# sent to, or embedded in, the frontend).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_STORAGE_BUCKET=creatiq-assets

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGIN=http://localhost:3000

# Optional: enables the real (paid, metered) Cloudflare Workers AI
# image provider instead of the no-cost stub. See
# src/services/ai/README.md for pricing details before setting these.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
