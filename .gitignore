
# ============================================================
# CREATIQ — Root Git Ignore
# ============================================================

# Dependencies
node_modules/
**/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Cloud credentials and private keys
*.pem
*.key
*.p12
*.pfx
.dev.vars
.dev.vars.*

# Cloudflare local runtime artifacts
.wrangler/
**/.wrangler/

# Next.js
.next/
**/.next/
out/

# Build outputs
dist/
**/dist/
build/
coverage/
.turbo/
.cache/

# TypeScript
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Test and coverage artifacts
.nyc_output/
*.lcov

# Package manager caches
.npm/
.pnpm-store/

# Supabase local development artifacts
supabase/.temp/
supabase/.branches/

# Local databases
*.sqlite
*.sqlite3
*.db

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Temporary files
*.tmp
*.temp
*.bak

# Generated archives
*.tgz

# Python artifacts (reserved for future tooling)
__pycache__/
*.py[cod]
.venv/
venv/

# Local migration review and backup files
supabase/migrations/*.backup.txt
supabase/migrations/migration_for_review.txt

# Nested lockfile; use the root workspace lockfile
/apps/web/package-lock.json